# Finder — configuration template. Copy to `.env` (never commit real values).
# Production secrets belong in a secrets manager: Supabase Edge Function
# secrets (`supabase secrets set ...`) and GitHub Actions repository secrets.

# ---- App build (passed with --dart-define; public by design) ---------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/anon key: safe to ship in the app, access is enforced by RLS.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Edge Function secrets (server only; NEVER in the app) -----------------
# Provided automatically by Supabase: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# Media key-encryption keys (KEKs): JSON map of version -> base64 32 random bytes.
# Generate one with:  openssl rand -base64 32
MEDIA_KEKS={"v1":"REPLACE_WITH_BASE64_32_BYTES"}
MEDIA_KEK_ACTIVE=v1

# Browser origins allowed to call the functions (comma separated).
ALLOWED_ORIGINS=https://app.finder.example

# Google Cloud Vision API key (SafeSearch). Restrict it to the Vision API.
# Without it, every uploaded photo waits for manual moderator review.
GOOGLE_VISION_API_KEY=

# RevenueCat webhook shared secret (also set in the RevenueCat dashboard).
REVENUECAT_WEBHOOK_AUTH=REPLACE_WITH_LONG_RANDOM_STRING
